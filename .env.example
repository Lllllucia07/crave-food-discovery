# Leave blank for demo mode. Google Places keys belong in Edge Function secrets only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional production Photon-compatible geocoding endpoint
# EXPO_PUBLIC_GEOCODER_URL=https://your-photon.example/api/

# Optional OAuth linking; keep off for anonymous classroom testing.
# EXPO_PUBLIC_ACCOUNT_LINKING_ENABLED=false
